<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceScreen
        app:key="general_settings"
        app:summary="Version 1.0 Jag-Stang"
        app:icon="@mipmap/ic_launcher_round"
        app:title="@string/app_name">

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="enable_notifications"
            app:title="Enable Notifications"/>
    </PreferenceScreen>
    <PreferenceCategory app:title="Audio Settings">

        <ListPreference
            app:defaultValue="48000"
            app:entries="@array/sample_rate_entries"
            app:entryValues="@array/sample_rate_entries"
            app:key="sample_rate"
            app:title="Sample Rate"/>
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="wav"
            app:summary="Disable to use older OpenSLES input (not recommended)"
            app:title="Use highest quality possible"/>
        <DropDownPreference
            app:defaultValue="float"
            app:entries="@array/bit_depth_entries"
            app:entryValues="@array/bit_depth_entries"
            app:key="bit_depth"
            app:title="Wav Recording Bit Depth"/>
        <DropDownPreference
            app:defaultValue="float"
            app:entries="@array/bit_depth_entries"
            app:entryValues="@array/bit_depth_entries"
            app:key="flac_bit_depth"
            app:title="FLAC Recording Bit Depth"/>
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="mp3"
            app:title="MP3 Maximum Quality Recording"/>
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="opus"
            app:title="OPUS Maximum Quality Recording"/>
    </PreferenceCategory>
    <PreferenceCategory app:title="Presets">
        <Preference
            app:key="export"
            app:title="Export"
            app:summary="Export your presets to file"/>
        <Preference
            app:key="import"
            app:title="Import"
            app:summary="Import presets from file"/>
    </PreferenceCategory>
</PreferenceScreen>